# Cloudflare Pages. The app's files carry a content stamp in their address (dev/build.ps1:
# ?v=<hash>), so a changed file has a new address: they are cached for a year. The page itself
# is checked on every visit, so it always names the newest files.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/gallery3d.wasm
  Cache-Control: public, max-age=31536000, immutable
/gallery3d.js
  Cache-Control: public, max-age=31536000, immutable
/drawnui_host.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
